<mxfile host="app.diagrams.net" agent="Claude" version="21.0.0"><diagram name="Why AI review" id="why-ai-review"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1070" pageHeight="660" math="0" shadow="0" darkMode="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="同じ Claude でも、書く側とレビューする側では渡される情報が違う" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontColor=#1F2933;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="990" height="32" as="geometry" /></mxCell><mxCell id="flow-head" value="PR を出してからマージまで" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5A6875;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="76" width="990.0" height="22" as="geometry" /></mxCell><mxCell id="f0" value="① ローカルで&#xa;Claude と開発" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#DCE3EB;strokeWidth=1.5;fontSize=12;fontColor=#1F2933;fontStyle=1;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40.0" y="106" width="160.0" height="56" as="geometry" /></mxCell><mxCell id="f1" value="② push して&#xa;PR を作る" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#DCE3EB;strokeWidth=1.5;fontSize=12;fontColor=#1F2933;fontStyle=1;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="206.0" y="106" width="160.0" height="56" as="geometry" /></mxCell><mxCell id="f2" value="③ GitHub Actions&#xa;が起動" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#DCE3EB;strokeWidth=1.5;fontSize=12;fontColor=#1F2933;fontStyle=1;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometr